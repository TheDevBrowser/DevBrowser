<UserControl x:Class="DeveloperBrowser.App.BrowsingHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource CanvasBrush}" Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BROWSING HISTORY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Last 30 days" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="Stored locally on this device. Revisiting a page updates its latest visit." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Content="Clear history" Style="{StaticResource PrimaryButton}" Background="#FF8B3943" BorderBrush="#FFEE7780" VerticalAlignment="Center" Click="Clear_Click" /></Grid>
        <Border Grid.Row="1" Background="#FF182231" BorderBrush="#FF3A4960" BorderThickness="1" CornerRadius="10" Margin="0,20,0,0" Padding="10"><Grid><ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" SelectionChanged="HistoryList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#FF2F3E52" BorderThickness="0,0,0,1" Padding="11,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding LastVisitedAt, StringFormat={}{0:g}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" /><TextBlock Text="{Binding VisitCount, StringFormat={}{0} visits}" Foreground="#FF91C9F7" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyText" Text="No browsing history yet." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" /></Grid></Border>
    </Grid>
</UserControl>
