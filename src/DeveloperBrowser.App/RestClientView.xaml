vironmentColorButton}" ToolTip="Orange" Click="EnvironmentColor_Click" /><Button Tag="#A78BFA" Background="#FFA78BFA" Style="{StaticResource EnvironmentColorButton}" ToolTip="Purple" Click="EnvironmentColor_Click" /><Button Tag="#94A3B8" Background="#FF94A3B8" Style="{StaticResource EnvironmentColorButton}" ToolTip="Grey" Click="EnvironmentColor_Click" /><Button Tag="#F472B6" Background="#FFF472B6" Style="{StaticResource EnvironmentColorButton}" ToolTip="Pink" Click="EnvironmentColor_Click" /><Button Tag="#FACC15" Background="#FFFACC15" Style="{StaticResource EnvironmentColorButton}" ToolTip="Yellow" Click="EnvironmentColor_Click" /></StackPanel></StackPanel><StackPanel Grid.Row="3" Margin="0,15,0,0"><CheckBox x:Name="NewEnvironmentActiveBox" Content="Make this environment active" Foreground="#FFF4F7FB" FontWeight="SemiBold" /><TextBlock Text="Only one environment can be active at a time." Foreground="#FFB8C5D6" FontSize="10" Margin="22,4,0,0" /></StackPanel><Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NewEnvironmentErrorText" Foreground="#FFFFB4B4" FontSize="10" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Cancel" Style="{StaticResource StorageActionButton}" Click="NewEnvironmentCancel_Click" /><Button Grid.Column="2" Content="Create" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Click="NewEnvironmentCreate_Click" /></Grid></Grid></Border></Grid>
