ock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSecret}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="3" Text="Enabled" Foreground="#FFB8C5D6" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ManagerVariableKeyBox" Padding="8,5" ToolTip="Variable name, e.g. baseUrl" /><TextBox x:Name="ManagerVariableValueBox" Grid.Column="1" Margin="6,0" Padding="8,5" ToolTip="Value" /><Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}" Click="AddManagerVariable_Click" /></Grid><TextBlock Text="Secret values are masked and stored locally only." Foreground="#FF9FB0C5" FontSize="10" Margin="0,9,0,0" /></StackPanel></Border><Border Background="#FF171E29" BorderBrush="#FF35445B" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,12,0,0"><StackPanel><TextBlock Text="QUICK PREVIEW  ·  secrets masked" Foreground="#FFF5F8FC" FontWeight="SemiBold" FontSize="11" /><TextBox x:Name="EnvironmentManagerPreview" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel></Border></StackPanel></ScrollViewer></Grid></Border>
