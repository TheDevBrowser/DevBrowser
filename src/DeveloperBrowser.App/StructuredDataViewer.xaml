<UserControl x:Class="DeveloperBrowser.App.StructuredDataViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeveloperBrowser.App"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF292D37" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><WrapPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,8" /><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" /></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#FF292D37" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="TabBorder" Property="Background" Value="#FF193753" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="156" Style="{StaticResource SearchInput}" Tag="Search data…" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown" />
            <Button Content="Find" Click="Find_Click" Padding="9,5" Margin="6,0,6,0" />
            <Button Content="Copy full" Click="CopyFull_Click" Padding="9,5" Margin="0,0,5,0" />
            <Button Content="Copy value" Click="CopyValue_Click" Padding="9,5" Margin="0,0,5,0" />
            <Button Content="Copy path" Click="CopyPath_Click" Padding="9,5" Margin="0,0,5,0" />
            <Button Content="Format" Click="Format_Click" Padding="9,5" Margin="0,0,5,0" />
            <Button Content="Minify" Click="Minify_Click" Padding="9,5" Margin="0,0,8,0" />
            <TextBlock x:Name="InfoText" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
        </WrapPanel>
        <TabControl Grid.Row="1" MinHeight="0">
            <TabItem Header="Pretty">
                <TextBox x:Name="PrettyBox" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono" FontSize="12" />
            </TabItem>
            <TabItem Header="Raw">
                <TextBox x:Name="RawBox" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono" FontSize="12" />
            </TabItem>
            <TabItem x:Name="TreeTab" Header="Tree">
                <local:JsonTreeView x:Name="TreeView" Margin="0,6,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
