<UserControl x:Class="DeveloperBrowser.App.HttpResponseViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeveloperBrowser.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="#FF121A26" BorderBrush="#FF35445B" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="StatusBadge" CornerRadius="5" Padding="9,5" VerticalAlignment="Top">
                        <TextBlock x:Name="StatusText" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <TextBlock x:Name="TypeText" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Margin="0,12,0,0">
                <Expander x:Name="HeadersExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="False">
                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Response headers" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/><TextBlock Text="Metadata returned by the server" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="HeadersMetaText" Foreground="#FFCFE4FF" FontSize="10"/></Border></Grid></Expander.Header>
                    <local:KeyValueDataViewer x:Name="HeadersViewer" MinHeight="60"/>
                </Expander>
                <Expander x:Name="CookiesExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="False">
                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Response cookies" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/><TextBlock Text="Cookie changes requested by the server" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="CookiesMetaText" Foreground="#FFCFE4FF" FontSize="10"/></Border></Grid></Expander.Header>
                    <local:KeyValueDataViewer x:Name="CookiesViewer" MinHeight="55"/>
                </Expander>
                <Expander x:Name="BodyExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="True">
                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Response body" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/><TextBlock Text="Content returned by the server" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="BodyMetaText" Foreground="#FFCFE4FF" FontSize="10"/></Border></Grid></Expander.Header>
                    <local:StructuredDataViewer x:Name="BodyViewer" Height="360"/>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
