<UserControl x:Class="DeveloperBrowser.App.HttpRequestViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeveloperBrowser.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Background="#FF121A26" BorderBrush="#FF35445B" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="MethodBadge" CornerRadius="5" Padding="9,4" VerticalAlignment="Top">
                    <TextBlock x:Name="MethodText" FontFamily="Cascadia Mono" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBox x:Name="UrlText" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Padding="0" FontFamily="Cascadia Mono" FontSize="11" />
            </Grid>
        </Border>
        <StackPanel Margin="0,12,0,0">
            <Expander x:Name="QueryExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="True"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Query parameters" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" /><TextBlock Text="Decoded values from the request URL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="QueryMetaText" Foreground="#FFCFE4FF" FontSize="10" /></Border></Grid></Expander.Header><local:KeyValueDataViewer x:Name="QueryViewer" MinHeight="55" /></Expander>
            <Expander x:Name="HeadersExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="False"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Request headers" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" /><TextBlock Text="Metadata sent to the server" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="HeadersMetaText" Foreground="#FFCFE4FF" FontSize="10" /></Border></Grid></Expander.Header><local:KeyValueDataViewer x:Name="HeadersViewer" MinHeight="55" /></Expander>
            <Expander x:Name="CookiesExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="False"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Request cookies" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" /><TextBlock Text="Browser state attached to this request" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="CookiesMetaText" Foreground="#FFCFE4FF" FontSize="10" /></Border></Grid></Expander.Header><local:KeyValueDataViewer x:Name="CookiesViewer" MinHeight="55" /></Expander>
            <Expander x:Name="BodyExpander" Style="{StaticResource InspectorAccordion}" IsExpanded="True"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Request body" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" /><TextBlock Text="Content sent to the server" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="1" Style="{StaticResource InspectorMetaBadge}" VerticalAlignment="Center"><TextBlock x:Name="BodyMetaText" Foreground="#FFCFE4FF" FontSize="10" /></Border></Grid></Expander.Header><local:StructuredDataViewer x:Name="BodyViewer" Height="340" /></Expander>
        </StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
