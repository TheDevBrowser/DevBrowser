<Window x:Class="DeveloperBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeveloperBrowser.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Developer Browser" Height="840" Width="1440" MinHeight="600" MinWidth="1180"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="NetworkDrawerRow" Height="0" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="13,10">
                <StackPanel DockPanel.Dock="Top">
                    <Border Background="{StaticResource AccentBrush}" Width="40" Height="40" CornerRadius="12" Margin="0,0,0,16"><TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Button Style="{StaticResource IconButton}" Content="⌂" ToolTip="Browser" Click="ShowBrowserWorkspace_Click" />
                    <Button Style="{StaticResource IconButton}" Content="↗" ToolTip="REST client" Click="ShowRestWorkspace_Click" />
                    <Button Style="{StaticResource IconButton}" Content="◫" ToolTip="Collections" />
                    <Button Style="{StaticResource IconButton}" Content="◒" ToolTip="Network inspector" Click="ToggleNetworkInspector_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Settings" />
                    <Border Width="40" Height="40" CornerRadius="20" Background="#FF334155" Margin="0,8,0,0"><TextBlock Text="R" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,11">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="‹" Width="30" Height="30" Margin="0" Click="Back_Click" ToolTip="Back" />
                    <Button Style="{StaticResource IconButton}" Content="›" Width="30" Height="30" Margin="4,0,0,0" Click="Forward_Click" ToolTip="Forward" />
                    <Button Style="{StaticResource IconButton}" Content="↻" Width="30" Height="30" Margin="4,0,0,0" Click="Refresh_Click" ToolTip="Refresh" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Margin="14,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" Foreground="{StaticResource MutedTextBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox x:Name="AddressBar" Grid.Column="1" BorderThickness="0" Background="Transparent" Text="https://www.bing.com" VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown" />
                        <TextBlock Grid.Column="2" Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="☆" Width="32" Height="32" Margin="0" ToolTip="Bookmark" />
                    <Button Style="{StaticResource IconButton}" Content="⋯" Width="32" Height="32" Margin="8,0,0,0" ToolTip="More actions" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="BrowserWorkspace" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" Width="32" Height="32" Margin="4,5" Click="AddTab_Click" ToolTip="New tab" />
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White"><ContentControl x:Name="BrowserHost" /></Border>
        </Grid>

        <Grid x:Name="RestWorkspace" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="10">
            <local:RestClientView x:Name="RestClientView" />
        </Grid>

        <Border x:Name="NetworkInspectorHost" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Visibility="Collapsed" Panel.ZIndex="20">
            <Border.RenderTransform><TranslateTransform x:Name="NetworkInspectorTranslate" Y="340" /></Border.RenderTransform>
            <local:NetworkInspectorView x:Name="NetworkInspector" />
        </Border>

        <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource AccentBrush}"><Grid Margin="14,0"><TextBlock Text="●  All systems ready" Foreground="White" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="UTF-8     Spaces: 4" Foreground="#FFDDEBFF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
    </Grid>
</Window>
