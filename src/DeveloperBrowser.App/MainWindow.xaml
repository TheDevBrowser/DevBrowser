<Window x:Class="DeveloperBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeveloperBrowser.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Developer Browser" Height="840" Width="1440" MinHeight="600" MinWidth="1180"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="BrowserToolbarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="19" />
        </Style>
        <Style x:Key="BrowserActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="BookmarkFlyoutButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FF5A6A83" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="NetworkResizeRow" Height="0" />
            <RowDefinition x:Name="NetworkDrawerRow" Height="0" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="5" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="15,11">
                <StackPanel DockPanel.Dock="Top">
                    <Border Background="{StaticResource AccentBrush}" Width="46" Height="46" CornerRadius="14" Margin="0,0,0,16"><TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Button Style="{StaticResource IconButton}" ToolTip="Browser" Click="ShowBrowserWorkspace_Click"><Viewbox Width="21" Height="21"><Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="REST client" Click="ShowRestWorkspace_Click"><Viewbox Width="21" Height="21"><Path Data="M8.7,16.6L4.1,12L8.7,7.4L7.3,6L1.3,12L7.3,18L8.7,16.6M15.3,16.6L19.9,12L15.3,7.4L16.7,6L22.7,12L16.7,18L15.3,16.6M10.5,21L13.5,3H11.5L8.5,21H10.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Bookmarks" Click="ShowBookmarksWorkspace_Click"><Viewbox Width="21" Height="21"><Path Data="M10,4H2V20H22V6H12L10,4M4,8H20V18H4V8Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Network inspector" Click="ToggleNetworkInspector_Click"><Viewbox Width="21" Height="21"><Path Data="M6,3A3,3 0,1 0,6,9A3,3 0,0 0,6,3M18,3A3,3 0,1 0,18,9A3,3 0,0 0,18,3M12,15A3,3 0,1 0,12,21A3,3 0,0 0,12,15M8.4,7.8L10.5,15.3M15.6,7.8L13.5,15.3M9,6H15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource IconButton}" ToolTip="Settings"><Viewbox Width="21" Height="21"><Path Data="M19.4,13C19.5,12.7 19.5,12.3 19.5,12C19.5,11.7 19.5,11.3 19.4,11L21.5,9.4L19.5,5.9L17.1,6.9C16.6,6.5 16.1,6.2 15.5,6L15.1,3.5H10.9L10.5,6C9.9,6.2 9.4,6.5 8.9,6.9L6.5,5.9L4.5,9.4L6.6,11C6.5,11.3 6.5,11.7 6.5,12C6.5,12.3 6.5,12.7 6.6,13L4.5,14.6L6.5,18.1L8.9,17.1C9.4,17.5 9.9,17.8 10.5,18L10.9,20.5H15.1L15.5,18C16.1,17.8 16.6,17.5 17.1,17.1L19.5,18.1L21.5,14.6L19.4,13M13,15.5A3.5,3.5 0,1 1,13,8A3.5,3.5 0,0 1,13,15.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Border Width="46" Height="46" CornerRadius="23" Background="#FF334155" Margin="0,10,0,0"><TextBlock Text="R" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BrowserToolbarButton}" Click="Back_Click" ToolTip="Back"><Viewbox Width="19" Height="19"><Path Data="M20,11H7.8L13.4,5.4L12,4L4,12L12,20L13.4,18.6L7.8,13H20V11Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Button Style="{StaticResource BrowserToolbarButton}" Margin="6,0,0,0" Click="Forward_Click" ToolTip="Forward"><Viewbox Width="19" Height="19"><Path Data="M4,11V13H16.2L10.6,18.6L12,20L20,12L12,4L10.6,5.4L16.2,11H4Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Button Style="{StaticResource BrowserToolbarButton}" Margin="6,0,0,0" Click="Refresh_Click" ToolTip="Refresh"><Viewbox Width="19" Height="19"><Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Margin="18,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" Foreground="{StaticResource MutedTextBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox x:Name="AddressBar" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="8,8" FontSize="14" Text="https://www.google.com" VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown" MouseDoubleClick="AddressBar_MouseDoubleClick" />
                        <TextBlock Grid.Column="2" Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BookmarkButton" Style="{StaticResource BrowserActionButton}" ToolTip="Save bookmark" Click="Bookmark_Click"><Viewbox Width="18" Height="18"><Path Data="M6,3A2,2 0,0 0,4 5V21L12,17L20,21V5A2,2 0,0 0,18 3H6M6,5H18V17.8L12,14.8L6,17.8V5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                    <Button Style="{StaticResource BrowserActionButton}" Margin="8,0,0,0" ToolTip="More actions"><Viewbox Width="18" Height="18"><Path Data="M5,10A2,2 0,1 0,5 14A2,2 0,0 0,5 10M12,10A2,2 0,1 0,12 14A2,2 0,0 0,12 10M19,10A2,2 0,1 0,19 14A2,2 0,0 0,19 10Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="BrowserWorkspace" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" Width="32" Height="32" Margin="4,5" Click="AddTab_Click" ToolTip="New tab" />
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White"><ContentControl x:Name="BrowserHost" /></Border>
        </Grid>

        <Grid x:Name="RestWorkspace" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="10">
            <local:RestClientView x:Name="RestClientView" />
        </Grid>
        <Grid x:Name="BookmarksWorkspace" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="11">
            <ContentControl x:Name="BookmarkManagerHost" />
        </Grid>

        <GridSplitter x:Name="NetworkDrawerSplitter" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{StaticResource BorderBrush}" Visibility="Collapsed" Panel.ZIndex="21" ToolTip="Drag to resize the Network Inspector" />
        <Border x:Name="NetworkInspectorHost" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Visibility="Collapsed" Panel.ZIndex="20">
            <Border.RenderTransform><TranslateTransform x:Name="NetworkInspectorTranslate" Y="340" /></Border.RenderTransform>
            <local:NetworkInspectorView x:Name="NetworkInspector" />
        </Border>

        <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource AccentBrush}"><Grid Margin="14,0"><TextBlock Text="●  All systems ready" Foreground="White" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="UTF-8     Spaces: 4" Foreground="#FFDDEBFF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
        <Popup x:Name="BookmarkFlyout" PlacementTarget="{Binding ElementName=BookmarkButton}" Placement="Bottom" HorizontalOffset="-360" VerticalOffset="10" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
            <Border Width="430" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" SnapsToDevicePixels="True" PreviewKeyDown="BookmarkFlyout_KeyDown">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BOOKMARK" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="BookmarkFlyoutTitle" Text="Save this page" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="Local only" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" /></Grid>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="Title" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBox x:Name="BookmarkTitleBox" Margin="0,6,0,0" Padding="10,7" /><TextBlock x:Name="BookmarkUrlText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="1,7,1,0" /></StackPanel>
                    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Folder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><ComboBox x:Name="BookmarkFolderBox" DisplayMemberPath="Name" Margin="0,6,0,0" Padding="9,6" /></StackPanel><Button Grid.Column="1" Content="+ Folder" Style="{StaticResource BookmarkFlyoutButton}" Margin="10,21,0,0" Click="BookmarkCreateFolderToggle_Click" /></Grid>
                    <StackPanel x:Name="BookmarkNewFolderPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Text="New folder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="BookmarkNewFolderBox" Padding="10,7" /><Button Grid.Column="1" Content="Create" Style="{StaticResource BookmarkFlyoutButton}" Margin="8,0,0,0" Click="BookmarkCreateFolder_Click" /></Grid></StackPanel>
                    <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock Text="Description" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBox x:Name="BookmarkDescriptionBox" Margin="0,6,0,0" Padding="10,7" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><Button Content="+ Add note" Style="{StaticResource BookmarkFlyoutButton}" HorizontalAlignment="Left" Margin="0,9,0,0" Click="BookmarkAddNote_Click" /></StackPanel>
                    <StackPanel x:Name="BookmarkNotePanel" Grid.Row="5" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Text="Why did you save this?" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBox x:Name="BookmarkNoteBox" Margin="0,6,0,0" Padding="10,7" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                    <Grid Grid.Row="6" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="BookmarkHintText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Content="View all →" Style="{StaticResource BookmarkFlyoutButton}" Click="BookmarkViewAll_Click" /><Button x:Name="BookmarkRemoveButton" Grid.Column="2" Content="Remove" Style="{StaticResource BookmarkFlyoutButton}" Foreground="#FFFCA5A5" Margin="8,0,0,0" Click="BookmarkRemove_Click" /><Button Grid.Column="3" Content="Cancel" Style="{StaticResource BookmarkFlyoutButton}" Margin="8,0,0,0" Click="BookmarkCancel_Click" /><Button x:Name="BookmarkSaveButton" Grid.Column="4" Content="Save bookmark" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="BookmarkSave_Click" /></Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
