<UserControl x:Class="DeveloperBrowser.App.NewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeveloperBrowser.App"
             Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.7" RadiusY="0.85">
                <GradientStop Color="#FF171F22" Offset="0" />
                <GradientStop Color="#FF0D1118" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <ScrollViewer x:Name="Viewport" Margin="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Height="{Binding ActualHeight, ElementName=Viewport}" MinHeight="440">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="1" MaxWidth="940">
                    <TextBlock x:Name="StatusMessage" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,24" />
                    <Border BorderThickness="2" CornerRadius="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#FF738E2C" />
                                <Setter Property="Background" Value="#FF171E27" />
                                <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="{StaticResource Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.08" /></Setter.Value></Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="{StaticResource Accent}" BlurRadius="30" ShadowDepth="0" Opacity="0.2" /></Setter.Value></Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Height="76" FontSize="20" Padding="0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                     AutomationProperties.Name="Search or enter a URL" KeyDown="SearchBox_KeyDown">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Path Data="M10,4A6,6 0,1 0,10,16A6,6 0,0 0,10,4M14.5,14.5L20,20" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.7" Width="26" Height="26" Stretch="Uniform" Margin="28,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="82,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Watermark" Text="Search anything or enter a URL" FontSize="20" Foreground="{StaticResource MutedTextBrush}" Margin="82,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Button Grid.Column="1" Click="Search_Click" ToolTip="Search or open URL (Enter)" AutomationProperties.Name="Search or open URL" Width="48" Height="48" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="{StaticResource SurfaceBrush}" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="{StaticResource SurfaceBrush}" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="M3,12H25 M15,2L25,12L15,22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="24" />
                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{x:Static local:BrowserShortcuts.All}" Margin="20,34,8,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#660D1118" BorderBrush="#FF2C3843" BorderThickness="1" CornerRadius="10" Padding="9,8,16,8" Margin="0,0,12,12">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Label}">
                                        <ItemsControl ItemsSource="{Binding Keys}" AlternationCount="10">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="+" Foreground="{StaticResource MutedTextBrush}" Margin="7,0" VerticalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <Border BorderBrush="#FF364350" BorderThickness="1" CornerRadius="7" Padding="11,7" MinWidth="36">
                                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF232D39" Offset="0" /><GradientStop Color="#FF171E27" Offset="1" /></LinearGradientBrush></Border.Background>
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Ellipse Height="26" Margin="80,24,80,0" IsHitTestVisible="False">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#247E9E29" Offset="0" /><GradientStop Color="#007E9E29" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
