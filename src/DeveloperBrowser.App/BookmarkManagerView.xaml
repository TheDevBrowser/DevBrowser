<UserControl x:Class="DeveloperBrowser.App.BookmarkManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bookmarks="clr-namespace:DeveloperBrowser.Core.Bookmarks;assembly=DeveloperBrowser.Core"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="ManagerButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Setter Property="Background" Value="#FF202735" /><Setter Property="BorderBrush" Value="#FF36445A" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF2B3545" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="#FFFFFFFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="8" Padding="8,7"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FF193753" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid Margin="32,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BOOKMARKS" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel><TextBlock Grid.Column="1" Text="Local device" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" /></Grid>
        <Grid Grid.Row="1" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="FOLDERS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,5,0,8" /><ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" Tag="Search title, URL, note…" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" /></Grid>
                <Grid Grid.Row="1" Margin="0,16,0,0"><ListBox x:Name="BookmarkList" MouseDoubleClick="BookmarkList_MouseDoubleClick" PreviewMouseDown="BookmarkList_PreviewMouseDown"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type bookmarks:BookmarkItem}"><Border Padding="9,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="8" Background="#FF1E3A5F" VerticalAlignment="Top"><Grid><TextBlock Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding FaviconUrl}" Stretch="Uniform" /></Grid></Border><StackPanel Grid.Column="1" Margin="10,0,16,0"><TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /><TextBlock Text="{Binding Note}" Foreground="#FFBBD8FF" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal"><Button Style="{StaticResource ManagerButton}" Tag="{Binding}" Click="Open_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14"><Path Data="M4,5H14V7H6V18H17V10H19V20H4Z M12,4H20V12H18V7.5L10.5,15L9,13.5L16.5,6H12Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox><TextBlock Text="Open" Margin="6,0,0,0" /></StackPanel></Button><Button Style="{StaticResource ManagerButton}" Tag="{Binding}" Click="OpenNewTab_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14"><Path Data="M4,5H15V7H6V18H17V10H19V20H4Z M15,3H20V8H18V5H15Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox><TextBlock Text="New tab" Margin="6,0,0,0" /></StackPanel></Button><Button Style="{StaticResource ManagerButton}" Tag="{Binding}" Click="Edit_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14"><Path Data="M4,16.5V20H7.5L18.2,9.3L14.7,5.8L4,16.5 M16,4.5L17.2,3.3C17.7,2.8 18.5,2.8 19,3.3L20.7,5C21.2,5.5 21.2,6.3 20.7,6.8L19.5,8L16,4.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox><TextBlock Text="Edit" Margin="6,0,0,0" /></StackPanel></Button><Button Style="{StaticResource ManagerButton}" Tag="{Binding}" Click="Copy_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14"><Path Data="M8,4H19V17H8Z M5,7H6V20H16V19H7V8H5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Viewbox><TextBlock Text="Copy" Margin="6,0,0,0" /></StackPanel></Button><Button Style="{StaticResource ManagerButton}" Tag="{Binding}" Click="Delete_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14"><Path Data="M6,7V19H18V7 M4,5H20 M9,5V3H15V5 M10,10V16 M14,10V16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox><TextBlock Text="Delete" Margin="6,0,0,0" /></StackPanel></Button></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="No bookmarks found" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Save the current page from the toolbar to start a focused library." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" /></StackPanel></Grid>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
